---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { formatDate } from "../lib/format";
import { DISPLAY, BIO, PERSON, PERSON_ID, SITE } from "../lib/site";
import { buildStats, FEATURED_COUNT } from "../lib/stats";
import { loadHomepageMedia } from "../lib/media";

const stats = buildStats(await getCollection("posts"));
const homePosts = stats.posts.slice(0, FEATURED_COUNT);
const media = loadHomepageMedia();

const jsonLd = { "@context": "https://schema.org", "@graph": [PERSON, { "@type": "WebSite", "name": DISPLAY, "url": SITE, "author": { "@id": PERSON_ID } }] };
---
<Base title={DISPLAY} description={BIO} path="/" jsonLd={jsonLd} current="home">
  <header class="hero">
    <p class="hero-kicker l l0"><span class="i w0 fell">the</span></p>
    <h1 class="hero-title l l1">Essays</h1>
    <p class="hero-def l l2">{BIO}</p>
    <p class="hero-span l l3 fell">{stats.yearsActive}</p>
    <p class="hero-resume" data-resume hidden>
      <span class="fell">from </span><a data-resume-link href="/"></a>
    </p>
  </header>

  <div class="col front">
    <p class="toc-kicker">Recent</p>
    <ol class="toc">
      {homePosts.map((post) => (
        <li class="toc-item">
          <p class="toc-date"><time datetime={post.date}>{formatDate(post.date)}</time></p>
          <a class="toc-title" href={post.href}>{post.title}</a>
          {post.description && <p class="toc-sum">{post.description}</p>}
          {post.tags.length > 0 && <p class="toc-tags">{post.tags.join(" · ")}</p>}
        </li>
      ))}
    </ol>
    <p class="toc-more"><a href="/archive/">All {stats.total} essays</a></p>

    <p class="toc-kicker">Appearances</p>
    <ol class="toc">
      {media.latest.map((item) => (
        <li class="toc-item">
          <div class="toc-media-row">
            <img class="toc-thumb" src={item.image} alt="" width="76" height="48" loading="lazy" decoding="async" />
            <div>
              <p class="toc-date"><time datetime={item.date}>{formatDate(item.date)}</time></p>
              <a class="toc-title" href={item.href}>{item.title}</a>
            </div>
          </div>
        </li>
      ))}
    </ol>
    <p class="toc-more"><a href="/media-timeline/">All {media.total} appearances</a></p>
  </div>
</Base>
