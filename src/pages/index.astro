---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { formatDate } from "../lib/format";
import { HOME_DESCRIPTION, HOME_TITLE, PERSON, WEBSITE } from "../lib/site";
import { buildStats, FEATURED_COUNT } from "../lib/stats";
import { loadHomepageMedia } from "../lib/media";
import { IMAGE_SIZES } from "../lib/responsive-image";
import ResponsiveImage from "../components/ResponsiveImage.astro";

const stats = buildStats(await getCollection("posts"));
const homePosts = stats.posts.slice(0, FEATURED_COUNT);
const media = loadHomepageMedia();

const jsonLd = { "@context": "https://schema.org", "@graph": [PERSON, { ...WEBSITE, description: HOME_DESCRIPTION }] };
---
<Base title={HOME_TITLE} description={HOME_DESCRIPTION} path="/" jsonLd={jsonLd} current="home">
  <h1 class="sr-only">Essays</h1>

  <div class="col front">
    <p class="toc-kicker">Recent</p>
    <ol class="toc">
      {homePosts.map((post) => (
        <li class="toc-item">
          <p class="toc-date"><time datetime={post.date}>{formatDate(post.date)}</time></p>
          <a class="toc-title" href={post.href}>{post.title}</a>
          {post.description && <p class="toc-sum">{post.description}</p>}
          {post.tags.length > 0 && <p class="toc-tags">{post.tags.join(" · ")}</p>}
        </li>
      ))}
    </ol>
    <p class="toc-more"><a href="/archive/">All {stats.total} essays</a></p>

    <p class="toc-kicker">Appearances</p>
    <ol class="toc">
      {media.latest.map((item) => (
        <li class="toc-item">
          <div class="toc-media-row">
            <ResponsiveImage class="toc-thumb" src={item.image} alt="" width="76" height="48" loading="lazy" decoding="async" sizes={IMAGE_SIZES.thumb} kind="thumb" />
            <div>
              <p class="toc-date"><time datetime={item.date}>{formatDate(item.date)}</time></p>
              <a class="toc-title" href={item.href}>{item.title}</a>
            </div>
          </div>
        </li>
      ))}
    </ol>
    <p class="toc-more"><a href="/media-timeline/">All {media.total} appearances</a></p>
  </div>
</Base>
