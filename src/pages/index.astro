---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { DISPLAY, BIO, PERSON, PERSON_ID, SITE } from "../lib/site";
import { buildStats, FEATURED_COUNT } from "../lib/stats";
import { loadHomepageMedia } from "../lib/media";

const stats = buildStats(await getCollection("posts"));
const homePosts = stats.posts.slice(0, FEATURED_COUNT);
const media = loadHomepageMedia();

const jsonLd = { "@context": "https://schema.org", "@graph": [PERSON, { "@type": "WebSite", "name": DISPLAY, "url": SITE, "author": { "@id": PERSON_ID } }] };
---
<Base title={DISPLAY} description={BIO} path="/" jsonLd={jsonLd} current="home">
  <h1 class="wordmark">Diogo<span class="wordmark-dim"> Mónica</span></h1>
  <p class="bio">{BIO}</p>
  <p class="identity-links">
    <a href="https://diogomonica.com">diogomonica.com</a>
    <a rel="me" href="https://x.com/diogomonica">@diogomonica</a>
    <a rel="me" href="https://www.linkedin.com/in/diogomonica">LinkedIn</a>
  </p>

  <p class="section-label">Archive</p>
  <section class="stat-strip" aria-label="Writing and media stats">
    <article class="stat-card">
      <p class="stat-row">
        <span class="stat-label">Posts</span>
        <span class="stat-value">{stats.total}</span>
      </p>
      <p class="stat-row">
        <span class="stat-label">Media</span>
        <span class="stat-value">{media.total}</span>
      </p>
    </article>
    <article class="stat-card">
      <p class="stat-row">
        <span class="stat-label">Last post</span>
        <span class="stat-value">{stats.lastDate}</span>
      </p>
      <p class="stat-row">
        <span class="stat-label">Last appearance</span>
        <span class="stat-value">{media.lastDate}</span>
      </p>
    </article>
  </section>

  <section class="feed" aria-label="Posts">
    <div class="feed-head">
      <h2>Posts</h2>
      <a href="/archive/">All {stats.total}</a>
    </div>
    <div class="table-wrap">
      <table class="feed-table posts-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Title</th>
            <th class="col-topics">Topics</th>
          </tr>
        </thead>
        <tbody>
          {homePosts.map((post) => (
            <tr class="post-row">
              <td class="col-date"><time datetime={post.date}>{post.date}</time></td>
              <td class="col-title">
                <a href={post.href}>{post.title}</a>
                {post.description && <p>{post.description}</p>}
              </td>
              <td class="col-topics">{post.tags.join(", ")}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="feed latest-media" aria-label="Latest Media">
    <div class="feed-head">
      <h2>Latest Media</h2>
      <a href="/media-timeline/">All {media.total}</a>
    </div>
    <div class="table-wrap">
      <table class="feed-table media-table">
        <thead>
          <tr>
            <th>Date</th>
            <th></th>
            <th>Title</th>
          </tr>
        </thead>
        <tbody>
          {media.latest.map((item) => (
            <tr class="media-row">
              <td class="col-date"><time datetime={item.date}>{item.date}</time></td>
              <td class="col-thumb">
                <img class="media-thumb" src={item.image} alt="" width="40" height="23" loading="lazy" decoding="async" />
              </td>
              <td class="col-title">
                <a href={item.href}>{item.title}</a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Base>
