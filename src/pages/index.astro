---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { SITE, DISPLAY, BIO, SAME_AS } from "../lib/site";
const posts = (await getCollection("posts")).sort((a, b) => b.data.date.localeCompare(a.data.date));
const latest = posts.slice(0, 8);
const person = {
  "@type": "Person",
  "@id": SITE + "/#person",
  "name": DISPLAY,
  "alternateName": "Diogo Monica",
  "url": "https://diogomonica.com",
  "sameAs": SAME_AS,
  "jobTitle": [
    "General Partner, Haun Ventures",
    "Co-founder and Executive Chairman, Anchorage Digital",
    "Chairman, NEAR Foundation",
  ],
};
const jsonLd = { "@context": "https://schema.org", "@graph": [person, { "@type": "WebSite", "name": DISPLAY, "url": SITE, "author": { "@id": SITE + "/#person" } }] };
---
<Base title={DISPLAY} description={BIO} path="/" jsonLd={jsonLd}>
  <h1>{DISPLAY}</h1>
  <p class="bio">{BIO}</p>
  <p><a href="https://diogomonica.com">diogomonica.com</a> · <a rel="me" href="https://x.com/diogomonica">@diogomonica</a> · <a rel="me" href="https://www.linkedin.com/in/diogomonica">LinkedIn</a></p>
  <h2>Latest posts</h2>
  <ol class="post-list">
    {latest.map((post) => {
      const href = `/${post.data.date.replaceAll("-", "/")}/${post.data.slug}/`;
      return (
        <li>
          <time datetime={post.data.date}>{post.data.date}</time>
          <br />
          <a href={href}>{post.data.title}</a>
          {post.data.description && <p class="muted">{post.data.description}</p>}
        </li>
      );
    })}
  </ol>
  <p><a href="/archive/">All posts</a></p>
</Base>
