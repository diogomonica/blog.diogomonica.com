---
import { getCollection, render } from "astro:content";
import Base from "../../../../layouts/Base.astro";
import RecordRail from "../../../../components/RecordRail.astro";
import { PERSON, PERSON_ID, SITE } from "../../../../lib/site";
import { buildPostRecords } from "../../../../lib/posts";

export async function getStaticPaths() {
  const records = buildPostRecords(await getCollection("posts"));
  return records.map(({ post, readingTime, prev, next }) => {
    const [year, month, day] = post.data.date.split("-");
    return {
      params: { year, month, day, slug: post.data.slug },
      props: { post, readingTime, prev, next },
    };
  });
}

const { post, readingTime, prev, next } = Astro.props;
const { Content } = await render(post);
const { year, month, day, slug } = Astro.params;
const path = `/${year}/${month}/${day}/${slug}/`;
const url = new URL(path, SITE).href;
const posting = {
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.published,
  url,
  author: { "@id": PERSON_ID },
  mainEntityOfPage: url,
  inLanguage: "en",
  ...(post.data.tags.length > 0 ? { keywords: post.data.tags } : {}),
};
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [PERSON, posting],
};
---
<Base title={post.data.title} description={post.data.description} path={path} ogType="article" jsonLd={jsonLd} canonical={post.data.canonical}>
  <div class="post-layout">
    <RecordRail
      date={post.data.date}
      tags={post.data.tags}
      readingTime={readingTime}
      url={url}
      prev={prev}
      next={next}
    />
    <article class="read">
      <header>
        <h1>{post.data.title}</h1>
      </header>
      <div class="content">
        <Content />
      </div>
    </article>
  </div>
</Base>
