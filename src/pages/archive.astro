---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { DISPLAY } from "../lib/site";
import { buildStats, featuredKey, featuredKeys } from "../lib/stats";

const stats = buildStats(await getCollection("posts"));
const featured = featuredKeys(stats.posts);
const byYear = [...stats.yearCounts].reverse().filter((y) => y.count > 0);
const years = [...byYear].reverse().map((y) => y.year);
---
<Base title="Archive" description={`All posts by ${DISPLAY}`} path="/archive/" current="archive">
  <header class="page-head">
    <h1 class="wordmark">All<span class="wordmark-dim"> posts</span></h1>
    <p>{stats.total} essays, {stats.yearsActive}.</p>
  </header>

  <div class="archive-feed" data-archive>
    <div class="archive-tools">
      <div class="chips" role="group" aria-label="Filter posts">
        <button type="button" data-archive-filter="featured">Featured</button>
        <button type="button" data-archive-filter="all" aria-pressed="true">All</button>
        {years.map((year) => (
          <button type="button" data-archive-filter={year}>{year}</button>
        ))}
      </div>
      <label class="archive-search">
        <span class="sr-only">Search posts</span>
        <input type="search" name="q" placeholder="Search" data-archive-search autocomplete="off" />
      </label>
    </div>

    {byYear.map((year) => (
      <section class="archive-block" id={`y${year.year}`} data-year={year.year} data-archive-year={year.year}>
        <h2>{year.year} · {year.count}</h2>
        <div class="table-wrap">
          <table class="feed-table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Title</th>
                <th>Topics</th>
              </tr>
            </thead>
            <tbody>
              {stats.posts.filter((post) => post.year === year.year).map((post) => (
                <tr
                  class="post-row"
                  data-year={post.year}
                  data-featured={featured.has(featuredKey(post)) || undefined}
                  data-search={[post.title, post.description, ...post.tags].join(" ").toLowerCase()}
                >
                  <td class="col-date"><time datetime={post.date}>{post.date}</time></td>
                  <td class="col-title">
                    <a href={post.href}>{post.title}</a>
                  </td>
                  <td class="col-topics">{post.tags.join(", ")}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}
    <p class="archive-empty" data-archive-empty hidden>No posts match.</p>
  </div>
</Base>

<script>
  const root = document.querySelector("[data-archive]");
  if (root) {
    const buttons = [...root.querySelectorAll("[data-archive-filter]")];
    const search = root.querySelector("[data-archive-search]");
    const rows = [...root.querySelectorAll(".post-row")];
    const blocks = [...root.querySelectorAll("[data-archive-year]")];
    const empty = root.querySelector("[data-archive-empty]");
    let filter = "all";

    const apply = () => {
      const query = (search instanceof HTMLInputElement ? search.value : "").trim().toLowerCase();
      let visible = 0;

      for (const row of rows) {
        const year = row.getAttribute("data-year");
        const featured = row.hasAttribute("data-featured");
        const haystack = row.getAttribute("data-search") ?? "";
        const yearOk = filter === "all" || filter === "featured" || year === filter;
        const featuredOk = filter !== "featured" || featured;
        const searchOk = !query || haystack.includes(query);
        const show = yearOk && featuredOk && searchOk;
        row.toggleAttribute("hidden", !show);
        if (show) visible += 1;
      }

      for (const block of blocks) {
        const hasRow = [...block.querySelectorAll(".post-row")].some((row) => !row.hasAttribute("hidden"));
        block.toggleAttribute("hidden", !hasRow);
      }

      empty?.toggleAttribute("hidden", visible > 0);
    };

    for (const button of buttons) {
      button.addEventListener("click", () => {
        filter = button.getAttribute("data-archive-filter") ?? "all";
        for (const other of buttons) {
          other.setAttribute("aria-pressed", String(other === button));
        }
        apply();
      });
    }

    search?.addEventListener("input", apply);
  }
</script>
