---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { DISPLAY } from "../lib/site";
import { buildStats } from "../lib/stats";

const stats = buildStats(await getCollection("posts"));
const byYear = [...stats.yearCounts].reverse().filter((y) => y.count > 0);
---
<Base title="Archive" description={`All posts by ${DISPLAY}`} path="/archive/" current="archive">
  <header class="page-head">
    <p class="kicker">Archive</p>
    <h1>All posts</h1>
    <p>{stats.total} essays, {stats.yearsActive}. Same URLs as the original Ghost archive.</p>
  </header>

  {byYear.map((year) => (
    <section class="archive-block" id={`y${year.year}`}>
      <h2>{year.year} · {year.count}</h2>
      <div class="table-wrap">
        <table class="feed-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Title</th>
              <th>Topics</th>
            </tr>
          </thead>
          <tbody>
            {stats.posts.filter((post) => post.year === year.year).map((post) => (
              <tr class="post-row">
                <td class="col-date"><time datetime={post.date}>{post.date}</time></td>
                <td class="col-title">
                  <a href={post.href}>{post.title}</a>
                </td>
                <td class="col-topics">
                  {post.tags.map((tag) => <span class="topic-chip">{tag}</span>)}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  ))}
</Base>
