---
import Base from "./Base.astro";
import { DISPLAY, SITE } from "../lib/site";
const { title, description, permalink } = Astro.props.frontmatter;
const path = permalink || "/media-timeline/";
const current = path === "/media-timeline/" ? "media" : undefined;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebPage", "name": title, "url": new URL(path, SITE).href, "description": description },
    { "@type": "Person", "@id": SITE + "/#person", "name": DISPLAY },
  ],
};
---
<Base title={title} description={description} path={path} jsonLd={jsonLd} current={current}>
  <article class:list={["content", { "media-page": path === "/media-timeline/" }]}>
    <p class="kicker">Media</p>
    <h1>{title}</h1>
    <slot />
  </article>
</Base>
