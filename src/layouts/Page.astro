---
import Base from "./Base.astro";
import { PERSON, SITE } from "../lib/site";

interface Props {
  title: string;
  description: string;
  path: string;
}

const { title, description, path } = Astro.props;
const current = path === "/media-timeline/" ? "media" : undefined;
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebPage", "name": title, "url": new URL(path, SITE).href, "description": description },
    PERSON,
  ],
};
---
<Base title={title} description={description} path={path} jsonLd={jsonLd} current={current}>
  <article class="ch col">
    <header class="ch-head">
      <p class="ch-kicker">Record</p>
      <h1 class="ch-title">Media timeline</h1>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>
