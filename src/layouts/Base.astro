---
import "../styles/global.css";
import { DISPLAY, SAME_AS, SITE } from "../lib/site";

interface Props {
  title: string;
  description: string;
  path: string;
  ogType?: string;
  jsonLd?: object;
  image?: string;
  current?: "home" | "about" | "archive" | "media";
  canonical?: string;
}
const { title, description, path, ogType = "website", jsonLd, image, canonical } = Astro.props;
const url = new URL(path, SITE).href;
const canonicalHref = canonical ?? url;
const ogImage = image ? new URL(image, SITE).href : new URL("/favicon.png", SITE).href;
const pageTitle = path === "/" ? DISPLAY : `${title} · ${DISPLAY}`;
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <meta name="color-scheme" content="light" />
  <meta name="theme-color" content="#ffffff" />
  <style is:inline>
    html{background:#fff;color:#1f2428;color-scheme:only light}
  </style>
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content={DISPLAY} />
  <link rel="canonical" href={canonicalHref} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title={DISPLAY} href={new URL("/rss.xml", SITE).href} />
  <link rel="preload" href="/fonts/eb-garamond-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/eb-garamond-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/im-fell-english-latin-400-italic.woff2" as="font" type="font/woff2" crossorigin />
  <meta property="og:site_name" content={DISPLAY} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content="@diogomonica" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  {SAME_AS.map((href) => <link rel="me" href={href} />)}
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <script is:inline>
    (function () {
      var root = document.documentElement;
      root.classList.add("js");
      try {
        if (window.matchMedia("(min-width: 1100px)").matches) root.classList.add("sidenotes");
      } catch (e) {}
      window.setTimeout(function () { root.classList.add("revealed"); }, 4000);
    })();
  </script>
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="mast">
    <nav class="mast-nav" aria-label="Site">
      <a href="https://diogomonica.com">Home</a>
      <a href="https://diogomonica.com/about">About</a>
      <a href="/" aria-current={path === "/" ? "page" : undefined}>Blog</a>
    </nav>
  </header>
  <main id="main"><slot /></main>
  <footer class="colophon">
    <p class="colophon-name">{DISPLAY}</p>
    <p class="colophon-fell fell">essays</p>
    <nav aria-label="More">
      <a href="/archive/">Archive</a>
      <a href="/about/">About this blog</a>
      <a href="/media-timeline/">Media</a>
      <a href="/rss.xml">RSS</a>
      <a href="https://diogomonica.com">diogomonica.com</a>
      <a rel="me" href="https://x.com/diogomonica">X</a>
      <a rel="me" href="https://www.linkedin.com/in/diogomonica">LinkedIn</a>
      <a rel="me" href="https://en.wikipedia.org/wiki/Diogo_Mónica">Wikipedia</a>
      <a href="#main">Back to top</a>
    </nav>
  </footer>
  <script>
    import "../scripts/reading.ts";
  </script>
</body>
</html>
