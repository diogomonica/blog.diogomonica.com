---
import type { RecordNeighbor } from "../lib/posts";

interface Props {
  url: string;
  prev: RecordNeighbor | null;
  next: RecordNeighbor | null;
}

const { url, prev, next } = Astro.props;
---
<nav class="record-nav" aria-label="Record">
  <dl class="rail-list">
    <div class="rail-item rail-copy">
      <dt>Link</dt>
      <dd>
        <button type="button" class="copy-link" data-copy-link={url} aria-live="polite">
          Copy link
        </button>
      </dd>
    </div>
    {prev && (
      <div class="rail-item">
        <dt>Previous</dt>
        <dd>
          <a href={prev.href}>{prev.title}</a>
          <time class="rail-neighbor-date" datetime={prev.date}>{prev.date}</time>
        </dd>
      </div>
    )}
    {next && (
      <div class="rail-item">
        <dt>Next</dt>
        <dd>
          <a href={next.href}>{next.title}</a>
          <time class="rail-neighbor-date" datetime={next.date}>{next.date}</time>
        </dd>
      </div>
    )}
  </dl>
</nav>
<script>
  const button = document.querySelector("[data-copy-link]");
  if (button instanceof HTMLButtonElement) {
    const url = button.dataset.copyLink ?? "";
    const idle = "Copy link";
    let timer = 0;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        const field = document.createElement("textarea");
        field.value = url;
        field.setAttribute("readonly", "");
        field.style.position = "fixed";
        field.style.left = "-9999px";
        document.body.appendChild(field);
        field.select();
        document.execCommand("copy");
        field.remove();
      }
      button.textContent = "Copied";
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.textContent = idle;
      }, 1600);
    });
  }
</script>
