---
import type { RecordNeighbor } from "../lib/posts";

interface Props {
  url: string;
  prev: RecordNeighbor | null;
  next: RecordNeighbor | null;
}

const { url, prev, next } = Astro.props;
---
<nav class="record-nav" aria-label="Record">
  <div class="record-nav-copy">
    <button type="button" class="copy-link" data-copy-link={url} aria-live="polite">
      Copy link
    </button>
  </div>
  {(prev || next) && (
    <div class="record-nav-row">
      {prev && (
        <a class="record-nav-btn record-nav-prev" href={prev.href}>
          <span class="record-nav-label">← Previous</span>
          <span class="record-nav-title">{prev.title}</span>
        </a>
      )}
      {next && (
        <a class="record-nav-btn record-nav-next" href={next.href}>
          <span class="record-nav-label">Next →</span>
          <span class="record-nav-title">{next.title}</span>
        </a>
      )}
    </div>
  )}
</nav>
<script>
  const button = document.querySelector("[data-copy-link]");
  if (button instanceof HTMLButtonElement) {
    const url = button.dataset.copyLink ?? "";
    const idle = "Copy link";
    let timer = 0;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        const field = document.createElement("textarea");
        field.value = url;
        field.setAttribute("readonly", "");
        field.style.position = "fixed";
        field.style.left = "-9999px";
        document.body.appendChild(field);
        field.select();
        document.execCommand("copy");
        field.remove();
      }
      button.textContent = "Copied";
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        button.textContent = idle;
      }, 1600);
    });
  }
</script>
