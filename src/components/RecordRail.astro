---
interface Props {
  date: string;
  tags: string[];
  readingTime: string;
}

const { date, tags, readingTime } = Astro.props;
const topics = tags.length > 0 ? tags.join(", ") : "—";
---
<aside class="record-rail" aria-label="Record">
  <dl class="rail-list">
    <div class="rail-item">
      <dt>Published</dt>
      <dd><time datetime={date}>{date}</time></dd>
    </div>
    <div class="rail-item">
      <dt>Topics</dt>
      <dd>{topics}</dd>
    </div>
    <div class="rail-item">
      <dt>Read</dt>
      <dd>{readingTime}</dd>
    </div>
  </dl>
</aside>
